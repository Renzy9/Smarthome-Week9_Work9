{
  "name": "figuro-smarthome-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "db:setup": "node --env-file-if-exists=.env src/setup.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:mysql": "node --env-file-if-exists=.env tests/mysql.integration.mjs"
  },
  "dependencies": {
    "mysql2": "3.24.5"
  }
}
